# Secrets/config for docker-compose.yml. `docker compose` (and start_docker.sh)
# read this file automatically from the project directory: nothing needs to be
# exported. Copy to .env (gitignored) and fill in the CHANGE-ME values.
#
# Wrap values in single quotes if they contain spaces or special characters.
# Changing a value makes compose recreate the container (tmux sessions end).
# Variables exported in your shell take precedence over this file.

# Browser login password for code-server.
CODE_SERVER_PASSWORD='CHANGE-ME'

# Long-lived Claude subscription token (run `claude setup-token` to generate).
# Avoids the OAuth refresh race between concurrent Claude sessions (see README).
CLAUDE_CODE_OAUTH_TOKEN='CHANGE-ME'

# Optional: API-key billing instead of the subscription token. Leave empty to
# use the token above.
ANTHROPIC_API_KEY=
